{{!
    @template enrol_programs/catalogue

    Beautiful program catalogue with grid/list view toggle.

    Context variables required for this template:
    * programs - Array of program objects
    * searchaction - URL for search form
    * searchquery - Current search query
    * hasprograms - Boolean if there are programs
    * totalcount - Total number of programs
    * paging - Paging bar HTML

    Example context (json):
    {
        "programs": [
            {
                "id": 1,
                "fullname": "Certificate Program",
                "description": "Description here",
                "coursecount": 12,
                "imageurl": "",
                "url": "/enrol/programs/catalogue/program.php?id=1",
                "isallocated": false,
                "completionstatus": ""
            }
        ],
        "hasprograms": true,
        "totalcount": 3
    }
}}

<div class="programs-catalogue" x-data="{
    view: localStorage.getItem('programsView') || 'grid',
    setView(v) {
        this.view = v;
        localStorage.setItem('programsView', v);
    }
}">
    {{! Header with search and view toggle }}
    <div class="catalogue-header">
        <div class="catalogue-search">
            <form action="{{searchaction}}" method="get" class="search-form">
                {{#hiddenfields}}
                    <input type="hidden" name="{{name}}" value="{{value}}">
                {{/hiddenfields}}
                <div class="search-input-wrapper">
                    <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.3-4.3"></path>
                    </svg>
                    <input type="text"
                           name="searchtext"
                           class="search-input"
                           placeholder="{{#str}}search{{/str}}..."
                           value="{{searchquery}}"
                           aria-label="{{#str}}search{{/str}}">
                    {{#searchquery}}
                    <a href="{{clearurl}}" class="search-clear" aria-label="{{#str}}clearsearch, enrol_programs{{/str}}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 6 6 18"></path>
                            <path d="m6 6 12 12"></path>
                        </svg>
                    </a>
                    {{/searchquery}}
                </div>
            </form>
        </div>

        <div class="catalogue-controls">
            <span class="program-count">{{totalcount}} {{#str}}programs, enrol_programs{{/str}}</span>

            <div class="view-toggle">
                <button type="button"
                        class="view-btn"
                        :class="{ 'active': view === 'grid' }"
                        @click="setView('grid')"
                        aria-label="{{#str}}gridview, enrol_programs{{/str}}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="7" height="7" x="3" y="3" rx="1"></rect>
                        <rect width="7" height="7" x="14" y="3" rx="1"></rect>
                        <rect width="7" height="7" x="14" y="14" rx="1"></rect>
                        <rect width="7" height="7" x="3" y="14" rx="1"></rect>
                    </svg>
                </button>
                <button type="button"
                        class="view-btn"
                        :class="{ 'active': view === 'list' }"
                        @click="setView('list')"
                        aria-label="{{#str}}listview, enrol_programs{{/str}}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="3" x2="21" y1="6" y2="6"></line>
                        <line x1="3" x2="21" y1="12" y2="12"></line>
                        <line x1="3" x2="21" y1="18" y2="18"></line>
                    </svg>
                </button>
            </div>
        </div>
    </div>

    {{#hasprograms}}
    {{! Grid View }}
    <div class="programs-grid" x-show="view === 'grid'" x-cloak>
        {{#programs}}
        <article class="program-card" data-programid="{{id}}">
            <a href="{{url}}" class="program-card-link">
                <div class="program-card-image">
                    {{#imageurl}}
                    <img src="{{imageurl}}" alt="" loading="lazy">
                    {{/imageurl}}
                    {{^imageurl}}
                    <div class="program-card-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                            <path d="m9 9.5 2 2 4-4"></path>
                        </svg>
                    </div>
                    {{/imageurl}}
                    {{#isallocated}}
                    <div class="program-badge enrolled">{{#str}}enrolled, enrol_programs{{/str}}</div>
                    {{/isallocated}}
                </div>

                <div class="program-card-content">
                    <h3 class="program-card-title">{{fullname}}</h3>

                    {{#shortdescription}}
                    <p class="program-card-description">{{shortdescription}}</p>
                    {{/shortdescription}}

                    <div class="program-card-meta">
                        <span class="meta-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                            </svg>
                            {{coursecount}} {{#str}}courses, enrol_programs{{/str}}
                        </span>
                        {{#hasrequirements}}
                        <span class="meta-item prereq">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path>
                            </svg>
                            {{#str}}prerequisites, enrol_programs{{/str}}
                        </span>
                        {{/hasrequirements}}
                    </div>

                    {{#isallocated}}
                    <div class="program-card-progress">
                        <div class="pc-progress-bar">
                            <div class="pc-progress-fill" style="width: {{progresspercent}}%"></div>
                        </div>
                        <span class="pc-progress-text">{{progresspercent}}% {{#str}}complete, enrol_programs{{/str}}</span>
                    </div>
                    {{/isallocated}}
                </div>
            </a>

            {{#tags}}
            <div class="program-card-tags">
                {{#taglist}}
                <span class="program-tag">{{name}}</span>
                {{/taglist}}
            </div>
            {{/tags}}
        </article>
        {{/programs}}
    </div>

    {{! List View }}
    <div class="programs-list" x-show="view === 'list'" x-cloak>
        {{#programs}}
        <article class="program-list-item" data-programid="{{id}}">
            <a href="{{url}}" class="program-list-link">
                <div class="program-list-image">
                    {{#imageurl}}
                    <img src="{{imageurl}}" alt="" loading="lazy">
                    {{/imageurl}}
                    {{^imageurl}}
                    <div class="program-list-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                            <path d="m9 9.5 2 2 4-4"></path>
                        </svg>
                    </div>
                    {{/imageurl}}
                </div>

                <div class="program-list-content">
                    <div class="program-list-header">
                        <h3 class="program-list-title">{{fullname}}</h3>
                        {{#isallocated}}
                        <span class="program-badge enrolled small">{{#str}}enrolled, enrol_programs{{/str}}</span>
                        {{/isallocated}}
                    </div>

                    {{#shortdescription}}
                    <p class="program-list-description">{{shortdescription}}</p>
                    {{/shortdescription}}

                    <div class="program-list-meta">
                        <span class="meta-item">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                            </svg>
                            {{coursecount}} {{#str}}courses, enrol_programs{{/str}}
                        </span>
                        {{#hasrequirements}}
                        <span class="meta-item prereq">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path>
                            </svg>
                            {{#str}}prerequisites, enrol_programs{{/str}}
                        </span>
                        {{/hasrequirements}}
                        {{#tags}}
                        {{#taglist}}
                        <span class="program-tag small">{{name}}</span>
                        {{/taglist}}
                        {{/tags}}
                    </div>
                </div>

                {{#isallocated}}
                <div class="program-list-progress">
                    <div class="progress-ring" style="--progress: {{progresspercent}}">
                        <svg viewBox="0 0 36 36">
                            <path class="progress-ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                            <path class="progress-ring-fill" stroke-dasharray="{{progresspercent}}, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                        </svg>
                        <span class="progress-ring-text">{{progresspercent}}%</span>
                    </div>
                </div>
                {{/isallocated}}

                <div class="program-list-arrow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                </div>
            </a>
        </article>
        {{/programs}}
    </div>

    {{! Pagination }}
    <div class="catalogue-pagination">
        {{{paging}}}
    </div>
    {{/hasprograms}}

    {{^hasprograms}}
    <div class="catalogue-empty">
        <div class="empty-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                <path d="M12 13V7"></path>
                <path d="M12 17h.01"></path>
            </svg>
        </div>
        <h3 class="empty-title">{{#str}}errornoprograms, enrol_programs{{/str}}</h3>
        <p class="empty-description">{{#str}}noprogramsfound, enrol_programs{{/str}}</p>
    </div>
    {{/hasprograms}}
</div>

{{#js}}
require(['jquery'], function($) {
    // Initialize any additional JS if needed
    console.log('Programs catalogue initialized');
});
{{/js}}
